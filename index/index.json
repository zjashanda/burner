  "workflows": [
    {
      "workflow_id": "wf.burn.tcl-dual-baseline",
      "steps": [
        "preflight",
        "boot:venusa",
        "burn:venusa",
        "verify:venusa",
        "burn:hisi",
        "recover:hisi",
        "verify:hisi",
        "receipt"
      ],
      "entry": "python scripts/burn.py all --profile scripts/profiles/tcl-pvm1005.json --run-dir <dir> --material-dir <dir> --confirm-write",
      "note": "严格串行；任一步 FAIL/BLOCKED 即停，执行 safe_recover 并写 FAIL 回执"
    },
    {
      "workflow_id": "wf.burn.single-venusa",
      "steps": [
        "preflight",
        "boot:venusa",
        "burn:venusa",
        "verify:venusa",
        "receipt"
      ],
      "entry": "python scripts/burn.py step <step> --profile scripts/profiles/tcl-pvm1005.json --run-dir <dir> --confirm-write",
      "note": "仓库当前没有单芯片 profile；单芯片按 step 顺序逐条执行（每步要求前序 PASS），收尾跑 receipt"
    },
    {
      "workflow_id": "wf.burn.single-hisi",
      "steps": [
        "preflight",
        "burn:hisi",
        "recover:hisi",
        "verify:hisi",
        "receipt"
      ],
      "entry": "python scripts/burn.py step <step> --profile scripts/profiles/tcl-pvm1005.json --run-dir <dir> --confirm-write",
      "note": "同上；recover:hisi 必须夹在 burn:hisi 与 verify:hisi 之间"
    },
    {
      "workflow_id": "wf.burn.version-swap",
      "steps": [
        "preflight",
        "burn:<chip>",
        "verify:<chip>",
        "receipt"
      ],
      "entry": "python scripts/burn.py all --profile ... --expect venusa=<ver> --expect hisi=<ver> --confirm-write",
      "note": "改期望值比改 profile 更安全；profile 不继承"
    },
    {
      "workflow_id": "wf.burn.recover-only",
      "steps": [
        "recover:hisi"
      ],
      "entry": "python scripts/burn.py step recover:hisi --profile ... --run-dir <dir> --confirm-write"
    },
    {
      "workflow_id": "wf.burn.preflight-only",
      "steps": [
        "preflight"
      ],
      "entry": "python scripts/burn.py preflight --profile ... --run-dir <dir>"
    },
    {
      "workflow_id": "wf.burn.csk6-hisi-dev01",
      "steps": [
        "preflight",
        "burn:csk6",
        "verify:csk6",
        "burn:hisi",
        "verify:hisi",
        "receipt"
      ],
      "entry": "python scripts/burn.py plan|preflight --profile scripts/profiles/csk6-hisi-dev01.json --run-dir <dir> --device-snapshot <port-map.json>（draft：写阶段需先把 profile 升级为 measured）",
      "note": "严格串行；任一步 FAIL/BLOCKED 即停并写出 FAIL 回执。CSK6 驱动 csk6-uart 已实现并单测，真机验收由节点侧 Issue 执行",
      "judgement_items": [
        {
          "n": 1,
          "item": "拓扑与设备存在性（topology=module_only|baseboard_present、baseboard_absent、SPI 对端）+ 逐节点端口枚举",
          "maps_to": "preflight（--device-snapshot）",
          "kb": "kb-method-c3adcba01df0 / kb-knowledge-99ced0adc4e3"
        },
        {
          "n": 2,
          "item": "CSK6 烧录：WRITE SIZE = expected_write_bytes、设备 MD5 = expected_md5、4 个标记齐全、exit 0",
          "maps_to": "burn:csk6",
          "kb": "kb-knowledge-368ec0d51d2c"
        },
        {
          "n": 3,
          "item": "HISI 烧录：optLog 分区集与写结果（分区集不一致记 NEEDS_REVIEW）",
          "maps_to": "burn:hisi",
          "kb": "kb-knowledge-5f25b39ebe82"
        },
        {
          "n": 4,
          "item": "上下电后启动：串口实际字节数与启动横幅（AP Boot Ready / HI3863 启动行）",
          "maps_to": "verify:csk6 / verify:hisi",
          "kb": "kb-knowledge-8ec3191c1698"
        },
        {
          "n": 5,
          "item": "120 s 稳定性：复位次数/间隔/异常行；module_only 下 13 s 周期复位记 EXPECTED_TOPOLOGY_BEHAVIOR",
          "maps_to": "verify 窗口外独立观测（lstest 侧）",
          "kb": "kb-knowledge-84602a2f32dc"
        },
        {
          "n": 6,
          "item": "资源监测：残留进程 / 句柄 / 可用内存",
          "maps_to": "burn 与 verify 前后采样（lstest 侧）",
          "kb": "kb-knowledge-158d1416a657"
        },
        {
          "n": 7,
          "item": "版本验收：设备原文 vs 包名原文（只消掉前导 V，中文档如实记差异）",
          "maps_to": "verify:csk6（version_key=csk6_app） / verify:hisi（hisi_sys_ver）",
          "kb": "kb-knowledge-5b92a7b0c5d9"
        }
      ],
      "verdict_rule": "整机结论取最差项；任一 FAIL/NEEDS_REVIEW 不得被其他 PASS 抵消（kb-method-cad7be93134e）"
    }
