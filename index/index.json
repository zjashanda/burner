  "workflows": [
    {
      "workflow_id": "wf.burn.tcl-dual-baseline",
      "steps": [
        "preflight",
        "boot:venusa",
        "burn:venusa",
        "verify:venusa",
        "burn:hisi",
        "recover:hisi",
        "verify:hisi",
        "receipt"
