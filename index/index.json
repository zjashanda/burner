      "note": "同上；recover:hisi 必须夹在 burn:hisi 与 verify:hisi 之间"
    },
    {
      "workflow_id": "wf.burn.version-swap",
      "steps": [
        "preflight",
        "burn:<chip>",
        "verify:<chip>",
        "receipt"
      ],
      "entry": "python scripts/burn.py all --profile ... --expect venusa=<ver> --expect hisi=<ver> --confirm-write",
      "note": "改期望值比改 profile 更安全；profile 不继承"
    },
    {
      "workflow_id": "wf.burn.recover-only",
      "steps": [
        "recover:hisi"
